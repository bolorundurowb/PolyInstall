{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/definitions/ManifestMetadata"
    },
    "build": {
      "$ref": "#/definitions/BuildConfiguration"
    },
    "ui": {
      "$ref": "#/definitions/UiConfiguration"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FilesEntry"
      }
    },
    "file_associations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/FileAssociation"
      }
    },
    "services": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/ServiceDefinition"
      }
    },
    "tasks": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/TasksConfiguration"
        }
      ]
    },
    "features": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/FeatureDefinition"
      }
    },
    "feature_index": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/PayloadFeatureIndex"
        }
      ]
    }
  },
  "definitions": {
    "ManifestMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "id": {
          "type": [
            "null",
            "string"
          ]
        },
        "publisher": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "BuildConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_dir": {
          "type": "string"
        },
        "output_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "compression": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "installer_target": {
          "type": [
            "null",
            "string"
          ]
        },
        "stub_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "signing": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/SigningBuildOptions"
            }
          ]
        },
        "windows": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/WindowsBuildOptions"
            }
          ]
        },
        "linux": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/LinuxBuildOptions"
            }
          ]
        },
        "macos": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/MacOsBuildOptions"
            }
          ]
        }
      }
    },
    "SigningBuildOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windows": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/WindowsSigningOptions"
            }
          ]
        },
        "linux": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/LinuxSigningOptions"
            }
          ]
        },
        "macos": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/MacOsSigningOptions"
            }
          ]
        }
      }
    },
    "WindowsSigningOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "certificate_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "certificate_thumbprint": {
          "type": [
            "null",
            "string"
          ]
        },
        "certificate_subject": {
          "type": [
            "null",
            "string"
          ]
        },
        "store_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "store_location": {
          "type": [
            "null",
            "string"
          ]
        },
        "certificate_password_env": {
          "type": [
            "null",
            "string"
          ]
        },
        "certificate_password": {
          "type": [
            "null",
            "string"
          ]
        },
        "timestamp_url": {
          "type": [
            "null",
            "string"
          ]
        },
        "file_digest_algorithm": {
          "type": "string"
        },
        "timestamp_digest_algorithm": {
          "type": "string"
        }
      }
    },
    "LinuxSigningOptions": {
      "type": "object",
      "additionalProperties": false
    },
    "MacOsSigningOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codesign_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "xcrun_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "identity": {
          "type": [
            "null",
            "string"
          ]
        },
        "keychain": {
          "type": [
            "null",
            "string"
          ]
        },
        "timestamp": {
          "type": "boolean"
        },
        "options": {
          "type": [
            "null",
            "string"
          ]
        },
        "notarization_profile": {
          "type": [
            "null",
            "string"
          ]
        },
        "staple": {
          "type": "boolean"
        }
      }
    },
    "WindowsBuildOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install_scope": {
          "type": "string"
        },
        "register_arp": {
          "type": "boolean"
        }
      }
    },
    "LinuxBuildOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string"
        }
      }
    },
    "MacOsBuildOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string"
        }
      }
    },
    "UiConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string"
        },
        "logo_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "assets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/UiAssetEntry"
          }
        },
        "wizard_steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WizardStep"
          }
        }
      }
    },
    "UiAssetEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "WizardStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": [
            "null",
            "string"
          ]
        },
        "source": {
          "type": [
            "null",
            "string"
          ]
        },
        "default_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "show_logs": {
          "type": "boolean",
          "default": true,
          "description": "Whether the progress step displays its detailed install log."
        }
      }
    },
    "FilesEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_dir": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "description": "Optional list of feature ids this entry belongs to. When null or empty, the matched files are always installed (core). When set, the matched files are only installed if at least one referenced feature is selected.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FileAssociation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extension": {
          "type": "string",
          "description": "The file extension, including the leading dot (e.g., \u0027.oef\u0027)."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the file type."
        },
        "prog_id": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional: The ProgID for the file association (e.g., \u0027MyApp.oef.1\u0027). If omitted, one will be generated based on the application name and extension."
        },
        "icon": {
          "type": [
            "null",
            "string"
          ],
          "description": "The path to the icon file for this file type, relative to the install directory."
        },
        "command": {
          "type": "string",
          "description": "The command to execute when opening a file of this type. Use \u0027%1\u0027 as a placeholder for the file path."
        },
        "mime_type": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional: The MIME type for this file association (Linux only). If omitted, one will be derived from the extension (e.g., \u0027.oef\u0027 -\u003E \u0027application/x-oef\u0027)."
        },
        "bundle_path": {
          "type": [
            "null",
            "string"
          ],
          "description": "macOS only: Path to the .app bundle to register associations for."
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "description": "Optional list of feature ids that gate this association. When null or empty, the association is always registered. When set, it is only registered if at least one referenced feature is selected.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ServiceDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional OS predicate that must be true for this service to be installed. Use os.isWindows, os.isLinux, or os.isMacOS/os.isOSX to target the platform service manager."
        },
        "name": {
          "type": "string",
          "description": "Service name. On macOS this is used as the launchd Label; reverse-DNS names are recommended."
        },
        "display_name": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional display name for platforms that distinguish it from the service name."
        },
        "description": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional service description."
        },
        "scope": {
          "type": "string",
          "description": "Service scope: system or user. Windows supports system only. Defaults to system."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the service should be enabled for startup. Defaults to true."
        },
        "start": {
          "type": "boolean",
          "description": "Whether the service should be started immediately after installation. Defaults to false."
        },
        "executable": {
          "type": "string",
          "description": "Path to the service executable. String values support PolyInstall path placeholders."
        },
        "arguments": {
          "type": [
            "array",
            "null"
          ],
          "description": "Optional command-line arguments passed to the service executable.",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional working directory. String values support PolyInstall path placeholders."
        },
        "restart": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional restart policy. Supported values are platform-specific."
        },
        "environment": {
          "type": [
            "null",
            "object"
          ],
          "description": "Optional environment variables for service managers that support them.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "description": "Optional feature ids that gate this service. When null or empty, the service always applies.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TasksConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_install": {
          "type": [
            "array",
            "null"
          ],
          "description": "Tasks that run after the user confirms the install destination, before any files are copied to disk.",
          "items": {
            "$ref": "#/definitions/InstallTask"
          }
        },
        "post_install": {
          "type": [
            "array",
            "null"
          ],
          "description": "Tasks that run after all files have been copied to the install directory and the installation is complete.",
          "items": {
            "$ref": "#/definitions/InstallTask"
          }
        },
        "pre_uninstall": {
          "type": [
            "array",
            "null"
          ],
          "description": "Tasks that run at the very start of uninstall, before the Add/Remove Programs entry is removed and before any installed files are deleted from disk. Installed files are still fully accessible here.",
          "items": {
            "$ref": "#/definitions/InstallTask"
          }
        },
        "post_uninstall": {
          "type": [
            "array",
            "null"
          ],
          "description": "Tasks that run after pre_uninstall tasks \u2014 but STILL BEFORE files are deleted from disk and BEFORE the Add/Remove Programs entry is removed. Despite its name, post_uninstall does not execute after the installation has been cleaned up. Both pre_uninstall and post_uninstall run while installed files are still present. Use post_uninstall for tasks that must follow pre_uninstall sequentially (e.g., stopping a service before removing its config) rather than for tasks that need the install tree to be gone.",
          "items": {
            "$ref": "#/definitions/InstallTask"
          }
        }
      }
    },
    "InstallTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require": {
          "type": [
            "null",
            "string"
          ],
          "description": "Optional OS predicate that must be true for this task to run. Supported values: os.isWindows/os.is_windows, os.isLinux/os.is_linux, os.isOSX/os.is_osx, os.isMacOS/os.is_macos, os.isUnix/os.is_unix (Linux or macOS). If omitted the task always runs."
        },
        "action": {
          "type": "string",
          "description": "The action to perform. One of: create_shortcut, write_registry (Windows only), create_desktop_entry (Linux only), set_permissions (Linux/macOS only), add_to_path, file_association."
        },
        "parameters": {
          "type": [
            "null",
            "object"
          ],
          "description": "Key/value map of parameters for the chosen action. Keys are snake_case strings.",
          "additionalProperties": {}
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "description": "Optional list of feature ids that gate this task. When null or empty, the task always runs (subject to require). When set, the task only runs if at least one referenced feature is selected.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FeatureDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier referenced by files[], tasks[], and file_associations[] entries. Lowercase snake_case is recommended."
        },
        "name": {
          "type": "string",
          "description": "Human-readable name shown in the installer\u0027s features step."
        },
        "description": {
          "type": [
            "null",
            "string"
          ],
          "description": "Short description shown alongside the feature checkbox in the installer."
        },
        "default_selected": {
          "type": "boolean",
          "description": "Whether the feature is pre-checked on a fresh install. Defaults to true."
        }
      }
    },
    "PayloadFeatureIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core_files": {
          "type": "array",
          "description": "Relative payload paths that are always installed regardless of selected features.",
          "items": {
            "type": "string"
          }
        },
        "feature_files": {
          "type": "object",
          "description": "Map of feature id \u2192 relative payload paths that belong to that feature. A file may appear under multiple features.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
