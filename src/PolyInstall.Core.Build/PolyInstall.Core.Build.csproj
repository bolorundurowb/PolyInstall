<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PolyInstall.Core.Build</RootNamespace>
    <Description>Build-time utilities for PolyInstall (YAML parsing, file globbing). Separated from the runtime library to keep installer and uninstaller stubs dependency-free.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolyInstall.Core\PolyInstall.Core.csproj" />
  </ItemGroup>
</Project>