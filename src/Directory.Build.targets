<Project>
  <!-- Cobertura output when tests run with /p:CollectCoverage=true (CI and local coverage workflows). -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Per-project folder so multiple test assemblies do not overwrite the same Cobertura file. -->
    <CoverletOutput>$(MSBuildThisFileDirectory)coverage/$(MSBuildProjectName)/</CoverletOutput>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <!-- Opt-in: msbuild /p:GeneratePolyInstallSchema=true to refresh schema/v1.json from POCOs -->
  <Target Name="GeneratePolyInstallSchema"
          BeforeTargets="BeforeBuild"
          Condition="'$(GeneratePolyInstallSchema)' == 'true'">
    <PropertyGroup>
      <_SchemaGenProj>$(MSBuildThisFileDirectory)PolyInstall.SchemaGen\PolyInstall.SchemaGen.csproj</_SchemaGenProj>
    </PropertyGroup>
    <Exec Command="dotnet run --no-build -c $(Configuration) --project &quot;$(_SchemaGenProj)&quot;" />
  </Target>
</Project>
