<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyInstall.UI.MainWindow"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <Image Name="BrandLogoImage"
               Grid.Row="0"
               Width="48"
               Height="48"
               HorizontalAlignment="Left"
               Margin="0,0,0,12"
               Stretch="Uniform"
               IsVisible="False" />
        <TextBlock Name="StepTitle"
                   Grid.Row="1"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <ContentControl Name="StepContent" Grid.Row="2" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Name="BackButton" Content="Back" Click="OnBack" />
            <Button Name="NextButton" Content="Next" Click="OnNext" />
            <Button Name="CancelButton" Content="Cancel" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
