<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PolyInstall.UI.MainWindow"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Name="BackButton" Content="Back" Click="OnBack" />
            <Button Name="NextButton" Content="Next" Click="OnNext" />
            <Button Name="CancelButton" Content="Cancel" Click="OnCancel" />
        </StackPanel>
        <StackPanel>
            <Image Name="BrandLogoImage"
                   Width="48"
                   Height="48"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12"
                   Stretch="Uniform"
                   IsVisible="False" />
            <TextBlock Name="StepTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <ContentControl Name="StepContent" />
        </StackPanel>
    </DockPanel>
</Window>
